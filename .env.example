# GEMINI_API_KEY: Optional fallback / Gemini AI model key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Groq API Key for Whisper Large v3 (fast word-level timestamps & silence detection)
GROQ_API_KEY=""

# MUSE_SPARK_API_KEY: Muse Spark / OpenAI-compatible API key for director reasoning
MUSE_SPARK_API_KEY=""

# MUSE_SPARK_BASE_URL: Base URL for Muse Spark (defaults to https://api.openai.com/v1 if not specified)
MUSE_SPARK_BASE_URL=""

# COVERR_API_KEY: Coverr API key for fetching vertical stock B-roll videos
COVERR_API_KEY=""

# APP_URL: Host URL
APP_URL="MY_APP_URL"

